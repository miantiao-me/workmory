{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./web/*"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "nitro/types", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": [
    "nitro.config.ts",
    "vite.config.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "drizzle.config.ts",
    "server/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts"
  ]
}
