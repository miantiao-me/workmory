{
  "name": "workmory",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:wrangler": "pnpm build && wrangler dev --env-file .env.local --local",
    "dev:local-bindings": "pnpm build && wrangler dev -c wrangler.local.jsonc --env-file .env.local --remote",
    "dev:remote": "pnpm build && wrangler dev -c wrangler.production.jsonc --env-file .env.production.local --remote",
    "build": "vite build",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:artifact": "node scripts/verify-built-worker.mjs",
    "test:staging-contract": "node scripts/verify-staging-contract.mjs",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "wrangler:types": "wrangler types",
    "migration:generate": "drizzle-kit generate",
    "migration:check": "drizzle-kit check",
    "migration:apply:local": "wrangler d1 migrations apply DB --local",
    "migration:apply:local-bindings": "wrangler d1 migrations apply workmory-local -c wrangler.local.jsonc --remote",
    "migration:apply:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:dry-run": "pnpm build && pnpm test:artifact && wrangler deploy --dry-run",
    "deploy": "pnpm build && pnpm test:artifact && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@react-sigma/core": "^5.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "events": "^3.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.4.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "remark-parse": "^11.0.0",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "usehooks-ts": "^3.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
