# Optional Cloudflare Access pair. Uncomment both together to enable Access JWT authentication.
# ACCESS_TEAM_DOMAIN=https://replace-before-deploy.invalid
# ACCESS_AUD=replace-before-deploy

# Secret: generate a unique random value of at least 32 bytes. Never use this placeholder in production.
ROOT_API_KEY=replace-before-deploy

# Workers AI embedding model and immutable Vectorize index dimensions.
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024

# Bump when rebuilding a disposable derived vector index.
VECTOR_INDEX_VERSION=replace-before-deploy
